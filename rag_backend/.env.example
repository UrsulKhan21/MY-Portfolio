# Local development with Docker Qdrant can use http://localhost:6333.
# Deployed backends need a reachable Qdrant Cloud URL, not localhost.
QDRANT_URL=https://your-cluster-url.qdrant.tech
QDRANT_API_KEY=
QDRANT_COLLECTION=abdur_ursul_khan_portfolio

GROQ_API_KEY=your-groq-api-key
LLM_MODEL=llama-3.1-8b-instant

EMBED_MODEL_NAME=all-MiniLM-L6-v2
EMBED_DIM=384

ALLOWED_ORIGINS=http://localhost:4173,https://your-vercel-app.vercel.app
ADMIN_TOKEN=change-this-token
